# Run python3 deploy/configure.py your-name.duckdns.org to generate deploy/.env.
# Use a hostname only, without https:// or a path.
APP_DOMAIN=your-name.duckdns.org
# Use generated hex values, which are safe in the database connection URL.
POSTGRES_PASSWORD=
SECRET_KEY=
# Optional password-reset email. SMTP must support STARTTLS on this port.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
