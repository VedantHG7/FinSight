{$APP_DOMAIN} {
    encode zstd gzip
    header X-Content-Type-Options nosniff
    header Referrer-Policy no-referrer

    handle /api/* {
        # App enforces a 10 MiB file limit; allow multipart overhead here.
        request_body {
            max_size 12MB
        }
        reverse_proxy https://finsight-api.mangograss-4056ef91.eastasia.azurecontainerapps.io
    }

    handle {
        root * /srv
        try_files {path} /index.html
        header Cache-Control "no-cache"
        file_server
    }
}
